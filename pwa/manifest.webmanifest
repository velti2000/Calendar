{
  "name": "Calendar",
  "short_name": "Calendar",
  "description": "Kalender-App im CalenGoo-Stil mit Anbindung an mailbox.org (CalDAV).",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
